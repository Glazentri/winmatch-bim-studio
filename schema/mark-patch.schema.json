{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WinMatch Revit mark patch",
  "type": "object",
  "required": [
    "schemaVersion",
    "patchType",
    "source",
    "projectId",
    "changes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "patchType": {
      "const": "mark-update"
    },
    "source": {
      "const": "Revit"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "expectedMark",
          "newMark"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expectedMark": {
            "type": "string"
          },
          "newMark": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "additionalProperties": false
      }
    }
  }
}
